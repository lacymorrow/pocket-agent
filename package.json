{
  "name": "cursor-pocket-agent",
  "displayName": "Pocket Agent",
  "version": "1.0.0",
  "description": "Mobile interface for Cursor's composer",
  "publisher": "cursor-tools",
  "icon": "icon.png",
  "main": "src/cursor-plugin.js",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "_extensionClient.toolCall",
        "title": "Execute Tool Call",
        "category": "Cursor"
      },
      {
        "command": "pocketAgent.readChatText",
        "title": "Pocket Agent: Read Chat Text",
        "category": "Pocket Agent"
      }
    ],
    "configuration": {
      "title": "Pocket Agent",
      "properties": {
        "pocketAgent.serverUrl": {
          "type": "string",
          "default": "http://localhost:3300",
          "description": "URL of the Pocket Agent backend server to which chat updates are sent."
        },
        "pocketAgent.pollInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Interval (in milliseconds) at which chat updates are polled and sent to the backend."
        },
        "pocketAgent.cursorDebugPort": {
          "type": "number",
          "default": 9223,
          "minimum": 1000,
          "description": "Remote debugging port that Cursor is launched with (passed via --remote-debugging-port)."
        }
      }
    }
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "package": "vsce package",
    "install-extension": "vsce package -o ./cursor-pocket-agent.vsix && cursor --install-extension ./cursor-pocket-agent.vsix --force && rm ./cursor-pocket-agent.vsix",
    "test": "mocha \"test/**/*.test.js\"",
    "coverage": "nyc npm test",
    "test:integration": "node scripts/runIntegrationTests.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "ws": "^8.18.2",
    "express-rate-limit": "^6.11.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "nodemon": "^3.0.2",
    "vsce": "^2.15.0",
    "vscode": "^1.1.37",
    "mocha": "^10.2.0",
    "chai": "^4.3.8",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.2",
    "eslint-plugin-node": "^11.1.0",
    "semantic-release": "^23.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.2",
    "@semantic-release/commit-analyzer": "^11.0.0",
    "@semantic-release/release-notes-generator": "^12.0.0",
    "nyc": "^15.1.0",
    "@vscode/test-electron": "^2.5.2"
  }
}
