{
  "name": "cursor-pocket-agent",
  "displayName": "Pocket Agent",
  "version": "1.0.0",
  "description": "Mobile interface for Cursor's composer",
  "publisher": "cursor-tools",
  "icon": "icon.png",
  "main": "src/cursor-plugin.js",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "_extensionClient.toolCall",
        "title": "Execute Tool Call",
        "category": "Cursor"
      },
      {
        "command": "pocketAgent.readChatText",
        "title": "Pocket Agent: Read Chat Text",
        "category": "Pocket Agent"
      }
    ],
    "configuration": {
      "title": "Pocket Agent",
      "properties": {
        "pocketAgent.serverUrl": {
          "type": "string",
          "default": "http://localhost:3300",
          "description": "URL of the Pocket Agent backend server to which chat updates are sent."
        },
        "pocketAgent.pollInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Interval (in milliseconds) at which chat updates are polled and sent to the backend."
        },
        "pocketAgent.cursorDebugPort": {
          "type": "number",
          "default": 9223,
          "minimum": 1000,
          "description": "Remote debugging port that Cursor is launched with (passed via --remote-debugging-port)."
        }
      }
    }
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "package": "vsce package",
    "install-extension": "vsce package -o ./cursor-pocket-agent.vsix && cursor --install-extension ./cursor-pocket-agent.vsix --force && rm ./cursor-pocket-agent.vsix"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "nodemon": "^3.0.2",
    "vsce": "^2.15.0",
    "vscode": "^1.1.37"
  }
}
